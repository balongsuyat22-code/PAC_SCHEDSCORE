# Copy the TiDB Cloud connection values into your ignored local .env file.
DB_HOST=YOUR_TIDB_HOST
DB_PORT=4000
DB_USER=YOUR_TIDB_USERNAME
DB_PASSWORD=YOUR_TIDB_PASSWORD
DB_NAME=pacsched_db
DB_SSL=true

# Set DB_CA_CERT to the full PEM text for Vercel. For local setup, use
# DB_CA_CERT_PATH with the downloaded certificate file path instead.
DB_CA_CERT=
# DB_CA_CERT_PATH=C:\path\to\tidb-ca.pem
DB_CONNECTION_LIMIT=5

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=https://YOUR_PROJECT.vercel.app
